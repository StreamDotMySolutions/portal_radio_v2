NEXT_PUBLIC_SITE_URL=http://localhost:8000
NEXT_PUBLIC_SERVER_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/frontend
WEBHOOK_SECRET=change-me-long-random-string

# Real-time chat (Laravel Reverb). Leave empty to use HTTP polling only.
# KEY must equal the API's REVERB_APP_KEY; production goes through nginx on 443.
NEXT_PUBLIC_REVERB_KEY=
NEXT_PUBLIC_REVERB_HOST=radio.rtm.gov.my
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# Google sign-in for chat (OAuth Web client ID; same value as GOOGLE_CLIENT_ID in api/.env). Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Search Console ownership tag: the content="..." value of the HTML-tag method. Keep it set permanently.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
